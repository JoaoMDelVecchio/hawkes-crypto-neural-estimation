% Opções do abntex2-alf para o TG em inglês. A entrada "abnt-cite-style=AuthorYEAR" do
% abntex2-options.bib colide com "AUTHORYEAR" (o BibTeX ignora maiúsculas nas chaves), por
% isso a citação em caixa mista da NBR 10520:2023 é ligada por esta chave própria.
@ABNT-options{tg-cite-mixed-case,
 abnt-cite-style="(Author, YEAR)",
 key="aaaa"}
