\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{itatg}[2026/11/02 Formato do Trabalho de Graduacao do ITA (modelo da Biblioteca)]
% Regras de admin/ita/modelo_tg.pdf, cap. 3 e 4: A4, margens 3/3/2/2 cm, Times 12,
% entrelinha 1,5, capítulos numerados em 18 negrito sem a palavra "capítulo", seções 14,
% subseções 12, títulos sem número centralizados em 18, paginação no canto superior direito
% (romanos a partir da folha de aprovação, arábicos seguindo a contagem a partir da
% Introdução), legenda "Figura 4.1 – título", citações autor-data da NBR 10520:2023.

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[brazilian,main=english]{babel}

\RequirePackage{microtype}
\RequirePackage[a4paper,left=3cm,top=3cm,right=2cm,bottom=2cm,headsep=0.6cm,
  headheight=14pt]{geometry}
\RequirePackage{setspace}
\RequirePackage{amsmath,mathtools}
\RequirePackage{newtxtext,newtxmath}% newtxmath já traz os símbolos do amssymb
\RequirePackage{booktabs,longtable,tabularx,array}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[labelsep=endash,font=small,labelfont=bf]{caption}
\RequirePackage{hyperref}
\RequirePackage{bookmark}
\RequirePackage[alf,abnt-and-type=&,abnt-etal-cite=4]{abntex2cite}
\AtBeginDocument{\citeoption{tg-cite-mixed-case}}

\hypersetup{
  colorlinks=true,
  allcolors=black,
  pdfcreator={LaTeX},
  pdfdisplaydoctitle=true,
  bookmarksnumbered=true,
  bookmarksopen=true
}

% Corpo do texto
\setstretch{1.5}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}
\setlength{\emergencystretch}{2em}
\setlist{nosep}
\renewcommand{\arraystretch}{1.2}

% Títulos
\titleformat{\chapter}[hang]{\bfseries\fontsize{18}{22}\selectfont}{\thechapter}{0.6em}{}
\titleformat{name=\chapter,numberless}[block]{\filcenter\bfseries\fontsize{18}{22}\selectfont}{}{0pt}{}
\titlespacing*{\chapter}{0pt}{0pt}{1.2\baselineskip}
\titleformat{\section}{\bfseries\fontsize{14}{17}\selectfont}{\thesection}{0.6em}{}
\titleformat{\subsection}{\bfseries\normalsize}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{0.6em}{}

% Número da página no canto superior direito, inclusive nas aberturas de capítulo
\fancypagestyle{itatg}{\fancyhf{}\fancyhead[R]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}}
\fancypagestyle{plain}{\fancyhf{}\fancyhead[R]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}}

